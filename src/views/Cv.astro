---
import Base from '../layouts/Base.astro';
import { contact, otherLang, routes, t, type Lang } from '../i18n/ui';
import { loadCv } from '../lib/cv';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cv = loadCv(lang);
const full = `mailto:${contact.email}?subject=${encodeURIComponent(t(lang, 'cv.fullSubject'))}`;
---
<Base lang={lang} section="cv" title={t(lang, 'cv.title')} description={cv.headline} alt={routes[otherLang(lang)].cv}>
  <div class="cv page wrap">
    <header>
      <h1 class="cv-name">{cv.name}</h1>
      <p class="lead">{cv.headline}</p>
      <p class="soft">{cv.location}</p>
    </header>

    <h2>{t(lang, 'cv.now')}</h2>
    <p>{cv.now}</p>

    <h2>{t(lang, 'cv.home')}</h2>
    <p>{cv.home}</p>
    <p><a class="link" href={routes[lang].cases}>{t(lang, 'cv.cases')}</a></p>

    <section class="skills" aria-labelledby="skills-title">
      <h2 id="skills-title">{t(lang, 'cv.skills')}</h2>
      <dl>
        {cv.skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd><ul>{s.items.map((i) => <li>{i}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </section>

    <h2>{t(lang, 'cv.before')}</h2>
    <p>{cv.before}</p>

    <h2>{t(lang, 'cv.education')}</h2>
    <ul class="plain">{cv.education.map((e) => <li>{e}</li>)}</ul>
    <p class="soft">{cv.languages}</p>

    <p class="full"><a class="button" href={full}>{t(lang, 'cv.full')}</a></p>
  </div>
</Base>

<style>
  .cv > * { max-width: 52rem; }
  .cv .lead { font-size: var(--step-statement); line-height: 1.25; color: var(--soft); margin-top: 0.5rem; }
  .cv-name { font-family: var(--font-display); font-weight: 400; font-size: var(--step-head); line-height: 0.95; letter-spacing: -0.03em; }
  .cv h2 { font-size: var(--step-statement); margin: 3rem 0 1rem; }
  .plain { list-style: none; padding: 0; }
  .plain li + li { margin-top: 0.35rem; }

  .skills { margin: 3.5rem 0; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--field); }
  .skills h2 { margin-top: 0; color: var(--accent); }
  .skills dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem var(--gutter); margin: 0; }
  .skills dt { font-weight: 700; margin-bottom: 0.5rem; }
  .skills dd { margin: 0; }
  .skills ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .skills li { font-size: var(--step-small); background: var(--deep); color: var(--ink); padding: 0.2em 0.6em; }

  .full { margin-top: 3rem; }
</style>
