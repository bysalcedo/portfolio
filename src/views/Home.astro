---
import Base from '../layouts/Base.astro';
import CaseCards from '../components/CaseCards.astro';
import PostRows from '../components/PostRows.astro';
import Emblem from '../components/Emblem.astro';
import LiveTerm from '../components/LiveTerm.astro';
import { otherLang, routes, t, ui, type Lang } from '../i18n/ui';
import { entries } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const r = routes[lang];
const s = ui[lang];
const cases = await entries('cases', lang);
const posts = await entries('blog', lang);
---
<Base lang={lang} alt={routes[otherLang(lang)].home}>
  <section class="hero" aria-labelledby="hero-title">
    <Emblem class="hero-emblem" />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>{t(lang, 'hero.eyebrow')}</p>
        <h1 id="hero-title" class="display" data-reveal style="--i:1"><span class="hello">{t(lang, 'hero.hello')}</span> {t(lang, 'hero.h1')}</h1>
        <p class="lead" data-reveal style="--i:2">{t(lang, 'hero.sentence')}</p>
        <div class="actions" data-reveal style="--i:3">
          <a class="button" href={r.cases}>{t(lang, 'hero.action')}</a>
          <a class="button ghost" href={r.cv}>{t(lang, 'hero.cv')}</a>
        </div>
      </div>
      <div data-reveal style="--i:4"><LiveTerm lang={lang} /></div>
    </div>
    <div class="wrap">
      <dl class="stats" aria-label={t(lang, 'stats.heading')}>
        {s['stats.items'].map((x, i) => (
          <div data-reveal style={`--i:${i}`}>
            <dt class="display nums">{x.n}</dt>
            <dd>{x.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="now-title">
    <div class="wrap split">
      <header>
        <p class="section-num" aria-hidden="true">01</p>
        <h2 id="now-title" class="display">{t(lang, 'now.title')}</h2>
        <p class="eyebrow soft-eyebrow">{t(lang, 'now.updated')}</p>
      </header>
      <dl class="now">
        {s['now.items'].map((x) => (
          <div>
            <dt class="eyebrow">{x.k}</dt>
            <dd>{x.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="cases-title">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="section-num" aria-hidden="true">02</p>
          <h2 id="cases-title" class="display">{t(lang, 'cases.title')}</h2>
        </div>
        <p>{t(lang, 'cases.intro')}</p>
      </header>
      <CaseCards lang={lang} items={cases} />
    </div>
  </section>

  <section class="section" aria-labelledby="posts-title">
    <div class="wrap">
      <header class="section-head">
        <div>
          <p class="section-num" aria-hidden="true">03</p>
          <h2 id="posts-title" class="display">{t(lang, 'blog.title')}</h2>
        </div>
        <a class="more" href={r.blog}>{t(lang, 'blog.all')}</a>
      </header>
      <PostRows lang={lang} items={posts.slice(0, 5)} />
    </div>
  </section>

  <section class="section rivers" aria-labelledby="names-title">
    <div class="wrap">
      <header class="split">
        <div>
          <p class="section-num" aria-hidden="true">04</p>
          <h2 id="names-title" class="display">{t(lang, 'names.title')}</h2>
        </div>
        <p class="names-intro">{t(lang, 'names.intro')}</p>
      </header>
      <ul class="names">
        {s['names.items'].map((x, i) => (
          <li class={i === 3 ? 'is-cluster' : undefined}>
            <span class="eyebrow">{x.r}</span>
            <strong class="display">{x.n}</strong>
            <span>{x.d}</span>
          </li>
        ))}
      </ul>
      <blockquote class="quote">{t(lang, 'names.quote')}</blockquote>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="wrap split">
      <header>
        <p class="section-num" aria-hidden="true">05</p>
        <h2 id="about-title" class="display">{t(lang, 'about.title')}</h2>
      </header>
      <div class="about-text">
        {s['about.text'].map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: brillo de menta, emblema de fondo y la tarjeta en vivo. */
  .hero { position: relative; overflow: hidden; padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem); isolation: isolate; }
  .hero::before { content: ''; position: absolute; inset: -20% -10% auto auto; width: 60rem; height: 60rem; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 16%, transparent), transparent); z-index: -1; pointer-events: none; }
  .hero :global(.hero-emblem) { position: absolute; right: -9rem; top: -6rem; width: clamp(26rem, 48vw, 44rem); color: var(--accent); opacity: 0.07; z-index: -1; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-emblem) { animation: spin 140s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  @media (max-width: 60rem) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 { font-size: clamp(3rem, 1.2rem + 6vw, 7rem); margin-top: 1.25rem; }
  .hello { display: block; font-size: 0.32em; letter-spacing: -0.01em; color: var(--accent); margin-bottom: 0.35em; }
  .hero .lead { font-size: var(--step-statement); line-height: 1.3; color: var(--soft); max-width: 36ch; margin-top: 1.5rem; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2.25rem; }

  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: clamp(3.5rem, 7vw, 6rem); border-top: 1px solid var(--line); }
  .stats > div { padding: 1.5rem 1.5rem 0 0; }
  .stats > div + div { padding-left: 1.5rem; border-left: 1px solid var(--line); }
  .stats dt { font-size: clamp(2.25rem, 1.5rem + 2.6vw, 4rem); color: var(--accent); }
  .stats dd { margin-top: 0.5rem; color: var(--soft); font-size: var(--step-small); max-width: 18ch; }
  @media (max-width: 52rem) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats > div + div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stats > div { padding-bottom: 1.5rem; }
    .stats > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  /* Dos columnas: titulo a la izquierda, contenido a la derecha. */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 2rem clamp(2rem, 6vw, 6rem); align-items: start; }
  .split h2 { font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3rem); }
  @media (max-width: 52rem) { .split { grid-template-columns: 1fr; } }
  .soft-eyebrow { color: var(--soft); margin-top: 1rem; }

  .now { display: grid; border-top: 1px solid var(--line); }
  .now > div { display: grid; grid-template-columns: 12rem 1fr; gap: 0.5rem 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .now dd { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); line-height: 1.5; }
  @media (max-width: 40rem) { .now > div { grid-template-columns: 1fr; } }

  .names-intro { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); line-height: 1.6; color: var(--soft); }
  .names { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: clamp(2.5rem, 5vw, 4rem); }
  .names li { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem; background: var(--bg); }
  .names strong { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); }
  .names li > span:last-child { color: var(--soft); font-size: var(--step-small); }
  .names .is-cluster { background: var(--accent); color: var(--accent-ink); }
  .names .is-cluster .eyebrow, .names .is-cluster > span:last-child { color: var(--accent-ink); }
  @media (max-width: 52rem) { .names { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .quote { margin-top: clamp(2.5rem, 5vw, 4rem); font-size: var(--step-statement); line-height: 1.35; max-width: 34ch; color: var(--ink); padding-left: 1.25rem; border-left: 2px solid var(--accent); }

  .about-text { display: grid; gap: 1.25rem; font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem); line-height: 1.5; color: var(--soft); max-width: 38rem; }
  .about-text p:first-child { color: var(--ink); }
</style>
